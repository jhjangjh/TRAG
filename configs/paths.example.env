# Required local paths. Do not commit configs/paths.env.
DATA_ROOT=/path/to/data
PRETRAIN_JSON=/path/to/data/LLaVA-Pretrain/blip_laion_cc_sbu_558k.json
INSTRUCT_JSON=/path/to/data/LLaVA-Finetune/llava_v1_5_mix665k.json
# The LLM path/ID must contain its family name (e.g. "qwen") for model registration.
STUDENT_MODEL=Qwen/Qwen2.5-0.5B
# A TinyLLaVA-format MLLM sharing the vision encoder and tokenizer vocabulary.
TEACHER_MODEL=/path/to/tinyllava-teacher
VISION_TOWER=google/siglip-so400m-patch14-384
OUTPUT_ROOT=/path/to/trag-runs

# Model/run settings.
CONV_VERSION=qwen2_base
RUN_NAME=trag-qwen2.5-0.5b
GPUS=0,1
MASTER_PORT=29501
MODEL_MAX_LENGTH=2048

# Per-device batch and accumulation values assume two GPUs (global batch 256/128/128).
# Measured peak memory per GPU (0.5B student, 3B teacher; SFT/DFT with the longest
# LLaVA-665K samples): DPT ~21 GB, SFT ~34 GB, DFT ~35 GB.
DPT_BATCH_SIZE=4
DPT_GRAD_ACCUM=32
SFT_BATCH_SIZE=8
SFT_GRAD_ACCUM=8
DFT_BATCH_SIZE=2
DFT_GRAD_ACCUM=32
